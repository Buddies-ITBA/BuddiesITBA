# Copy to .env.local. Everything is optional for local development:
# without NOTION_TOKEN the site runs on bundled sample content (src/lib/cms/sample.ts).

# Notion integration token (https://www.notion.so/my-integrations)
NOTION_TOKEN=

# Notion database IDs
NOTION_EVENTS_DB=
NOTION_BLOG_DB=
NOTION_TEAM_DB=
NOTION_FAQ_DB=

# Public URL used for share previews (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
