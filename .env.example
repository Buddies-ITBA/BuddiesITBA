# Copy to .env.local. Everything is optional for local development:
# without DATABASE_URL the app uses an embedded Postgres (PGlite) in .data/,
# created and filled with sample content on first run.
# Local admin: admin@buddies.local / buddies-admin

# Postgres connection string (Neon, Supabase, Railway, self-hosted…).
# For serverless hosts use the *pooled* URL.
DATABASE_URL=

# Transactional emails (registration confirmations, waitlist, buddy intros).
# Free tier at https://resend.com — verify your domain, then set both.
# Without them, emails are printed to the console and listed in /admin/emails.
RESEND_API_KEY=
EMAIL_FROM="Buddies ITBA <hola@tu-dominio.org>"

# Public URL used in emails and share previews (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
